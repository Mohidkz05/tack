# Managed by tack (`tack add ci`). `tack update` refreshes it; if you edit it, your version is kept.
name: tack verify

on:
  push:
    branches: [main]
  pull_request:

permissions:
  contents: read

concurrency:
  group: tack-verify-${{ github.ref }}
  cancel-in-progress: true

jobs:
  verify:
    runs-on: ubuntu-latest
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@v5
      - uses: actions/setup-python@v6
        with:
          python-version: "3.12"
{{setup_steps}}
      - name: Install dependencies
        run: python3 .claude/hooks/tack_runtime.py verify --only setup
      - name: Verify (format, lint, typecheck, test)
        run: python3 .claude/hooks/tack_runtime.py verify --markdown | tee -a "$GITHUB_STEP_SUMMARY"
